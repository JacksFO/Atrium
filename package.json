{
  "name": "atrium",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "A chat app. Anyone can sign up, add friends, and make their own servers or join somebody else's. Text, voice and screen sharing, on the web and the desktop.",
  "//packageManager": "The pnpm the workflow installs, so it cannot drift from the one that wrote pnpm-workspace.yaml. Pinning the workflow to 9 by hand failed the release: allowBuilds is 10-and-later syntax, and 9 rejects the file outright.",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @atrium/server --filter @atrium/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @atrium/server start",
    "typecheck": "pnpm -r typecheck",
    "desktop": "pnpm --filter atrium-desktop dev",
    "dist": "pnpm --filter atrium-desktop build",
    "voice": "vendor/livekit-server.exe --config livekit.yaml",
    "dev:all": "pnpm --parallel --filter @atrium/server --filter @atrium/web dev",
    "test:ui": "node test/ui/run.mjs",
    "monitor": "node scripts/monitor.mjs",
    "test:independence": "node test/server/run-independence.mjs",
    "test:containment": "node test/server/run-independence.mjs containmentparity.mjs",
    "test:calls": "node test/server/run-independence.mjs calls.mjs",
    "test:perms": "node test/server/run-independence.mjs memberperms.mjs",
    "test:channelperms": "node test/server/run-independence.mjs channelperms.mjs",
    "test:rolemove": "node test/server/run-independence.mjs rolemove.mjs",
    "test:permsaudit": "node test/server/run-independence.mjs permsaudit.mjs",
    "test:audit": "node test/server/run-independence.mjs audit.mjs",
    "test:attachments": "node test/server/run-independence.mjs attachments.mjs",
    "test:ownchannels": "node test/server/run-independence.mjs ownchannels.mjs",
    "test:coverart": "node test/server/run-independence.mjs coverart.mjs",
    "test:changelog": "node test/server/run-independence.mjs changelogroute.mjs",
    "test:launcher": "node test/server/launcher.mjs",
    "test:backup": "node test/server/backupverify.mjs",
    "test:gifs": "node test/server/gifimport.mjs",
    "shrink:images": "apps/desktop/node_modules/.bin/electron scripts/shrink-profile-images.mjs",
    "test:gifs:live": "pnpm --filter @atrium/server exec tsx src/scripts/checkgifs.ts",
    "test:sharedfiles": "node test/server/sharedfiles.mjs",
    "test:css": "node test/css/run.mjs",
    "test:desktop": "node test/desktop/run.mjs",
    "test:desktop:failure": "node test/desktop/run.mjs failure-screen.cjs",
    "test:desktop:watch": "node test/desktop/run.mjs client-watch.cjs",
    "test:names": "pnpm --filter @atrium/server test",
    "test:presence": "node test/server/run-independence.mjs presencegrace.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
