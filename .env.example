# Copy to .env and change AUTH_SECRET before anyone else joins.
# .env is gitignored. Never commit the real one.

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-before-anyone-joins

# Where the server listens. 0.0.0.0 so it is reachable over ZeroTier.
HOST=0.0.0.0
PORT=8787

# Serve over https with a self-signed certificate, generated on first run.
# Leave this on: browsers only offer the microphone prompt on a secure
# origin, so voice in a browser does not work without it. Everyone clicks
# through one certificate warning the first time, which is expected for a
# private server with no public domain.
TLS=true

# A real certificate, so nobody has to click through a warning.
#
# Proved over DNS, so the name may point at your private ZeroTier address
# and nothing is ever exposed to the internet. Leave ACME_DOMAIN blank to
# keep using the self-signed certificate.
#
# Cloudflare: create a token at
#   https://dash.cloudflare.com/profile/api-tokens
#   Permissions: Zone / DNS / Edit, limited to the one zone.
# DuckDNS: the token from https://www.duckdns.org after signing in.
ACME_DOMAIN=
ACME_EMAIL=
DNS_PROVIDER=            # cloudflare | duckdns
CLOUDFLARE_API_TOKEN=
DUCKDNS_TOKEN=
# Set true while testing. Staging certificates are untrusted, but the rate
# limits are generous - production allows only five failures per hour.
ACME_STAGING=false

# Proves whoever runs Atrium, for the two routes about the hardware rather
# than about anybody's server - /api/admin/health and /api/admin/storage.
# Sent as the x-operator-token header. Not an account: nobody signs in as
# this. Left empty, those routes do not answer at all.
OPERATOR_TOKEN=

# On-disk state. Both are gitignored.
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Per-file upload ceiling, in bytes. 25 MB.
MAX_UPLOAD_BYTES=26214400

# Invite-only. Registration needs a code from `pnpm invite`.
OPEN_REGISTRATION=false

# Extra browser origins allowed to call the API, comma separated.
# localhost and private network ranges (10.x, 192.168.x, 172.16-31.x, which
# covers ZeroTier) are always allowed, so this is usually left empty.
ALLOWED_ORIGINS=

# GIF picker. Set ONE of these; leave both blank to hide the GIF button.
# KLIPY wins when both are set.
#   KLIPY: https://partner.klipy.com  -> API Keys -> Add Platform
#   GIPHY: https://developers.giphy.com/dashboard/
# The key stays on the server - clients never see it, and their IP addresses
# are never sent to the provider.
#
# Both start you on a test key capped at 100 calls an hour for the whole
# server, and both want you to request production access once it works.
# KLIPY's production tier is free for life; GIPHY's is by negotiation and is
# reported to start near $9,000 a year, which is why KLIPY is first.
#
# Tenor used to be the recommendation here. Google stopped issuing keys in
# January 2026 and shut the API off on 30 June 2026, so TENOR_API_KEY is no
# longer read at all.
KLIPY_API_KEY=
GIPHY_API_KEY=

# How many provider calls an hour the picker may spend, across everybody.
# A test key is 100, so this sits just under it and says something honest
# when it runs out rather than being cut off mid-evening. Searches are
# remembered for an hour, so repeats cost nothing and never touch this.
#
# Production access is unlimited - a form in the Partner Panel, granted once
# the integration is branded and tested. SET THIS TO 0 when that lands, or it
# becomes the only thing still rationing GIFs.
GIF_CALLS_PER_HOUR=90

# Voice and screen share. Run vendor/livekit-server.exe with a matching
# config; see livekit.yaml in the repo root. Leave blank to hide voice.
# The URL is what clients connect to, so on another machine use the
# server's ZeroTier address rather than localhost.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=


# Screen sharing goes directly between people. Most pairs connect on STUN
# alone; these are the fallback relay for the ones that cannot, and are
# optional. Cloudflare's free allowance is 1000 GB/month.
# A TURN relay forwards encrypted packets and cannot read the stream.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# A second relay provider, optional and additive. Browsers are handed every
# relay we know about and use whichever answers, so this is resilience rather
# than a replacement - Open Relay's free allowance is 20 GB/month against
# Cloudflare's 1000 GB. Sign up at metered.ca and paste the credentials URL.
METERED_TURN_URL=

# Backups. Run scripts/install-tasks.cmd to take one nightly.
#
# Set a passphrase before copying backups anywhere else: without one they
# are plain files containing every message anybody has ever sent. Losing
# this passphrase means losing the backups, so keep it somewhere safe and
# separate from the machine it protects.
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups
# How many database snapshots to keep. They are a couple of hundred
# kilobytes each and genuinely different every night, so a month of them
# costs a few megabytes and buys a month of "put it back how it was on
# Tuesday". Uploads are not governed by this: they are stored one copy per
# file and never deleted automatically, because a UUID-named file never
# changes and keeping fourteen copies of it bought nothing.
BACKUP_KEEP=30
