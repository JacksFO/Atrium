node_modules/
dist/
# And anything else built beside it.
#
# `dist/` alone let two copies of a build into the repo in one afternoon -
# dist.prev while deploying, dist-desktop while packaging - because they are
# build output with a slightly different name. Everything that starts dist
# is build output.
#
# Written with # and not /* */: this file has no block comments, so `/*` was
# a pattern matching everything in the root and the lines under it were
# patterns too. Nothing already tracked changed, which is why it went unseen
# for a day - but every new file was silently ignored, and seven of them were
# a whole feature that never reached the repo.
dist-*/
dist.*/
release/
*.tsbuildinfo

# Generated app icon (produced by scripts/make-icon.mjs at build time)
apps/desktop/build/icon.png

# Runtime state — never commit these.
.env
# Contains the LiveKit API secret. livekit.example.yaml is the template.
livekit.yaml
# The downloaded LiveKit server binary (54 MB).
vendor/
data/
uploads/
# scratch dirs from audit runs
data-audit*/
uploads-audit*/
*.db
*.db-wal
*.db-shm

# Editor noise
.vscode/
.idea/
Thumbs.db
desktop.ini

# Backups contain every message; never commit them.
backups/
logs/

# Compiled output of the per-program audio addon. Generated by node-gyp on
# whichever machine builds the app, and specific to that machine's toolchain
# and Electron version - four generated project files went in by accident.
apps/desktop/native/appaudio/build/
apps/desktop/native/presence/build/

# The desktop app bundles its own copy of the client; never the live one.
apps/client/dist-desktop/

# A build of the desktop preload lands here when esbuild is run from the
# repo root instead of apps/desktop. The real one is apps/desktop/dist.
/preload.cjs

# Pasted screenshots, which land in the root and are not part of the app.
#
# By place rather than by name. This was `Atrium_*.png`, which is what one
# tool calls them - and a screenshot saved by a browser is called something
# else entirely, so `git add -A` committed one and it went to a public
# repository. Nothing at the top level of this repo is an image.
Atrium_*.png
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# The client that was live before the Atrium swap, kept on disk so a rollback
# is one command. Not history — history is in git; this is the exact folder,
# fingerprinted, and it belongs to this machine rather than to the repo.
apps/client/dist-before-atrium/
apps/client/dist-before-react/
